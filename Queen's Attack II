int queensAttack(int n, int k, int r_q, int c_q, int obstacles_rows, int obstacles_columns, int** obstacles) {
    // Initialize max steps in each direction
    int up = n - r_q;
    int down = r_q - 1;
    int right = n - c_q;
    int left = c_q - 1;
    int up_right = (n - r_q < n - c_q) ? n - r_q : n - c_q;
    int up_left = (n - r_q < c_q - 1) ? n - r_q : c_q - 1;
    int down_right = (r_q - 1 < n - c_q) ? r_q - 1 : n - c_q;
    int down_left = (r_q - 1 < c_q - 1) ? r_q - 1 : c_q - 1;

    for (int i = 0; i < obstacles_rows; i++) {
        int r_o = obstacles[i][0];
        int c_o = obstacles[i][1];

        // Same column
        if (c_o == c_q) {
            if (r_o > r_q) up = (r_o - r_q - 1 < up) ? r_o - r_q - 1 : up;
            else if (r_o < r_q) down = (r_q - r_o - 1 < down) ? r_q - r_o - 1 : down;
        }
        // Same row
        else if (r_o == r_q) {
            if (c_o > c_q) right = (c_o - c_q - 1 < right) ? c_o - c_q - 1 : right;
            else if (c_o < c_q) left = (c_q - c_o - 1 < left) ? c_q - c_o - 1 : left;
        }
        // Diagonals
        else if (abs(r_o - r_q) == abs(c_o - c_q)) {
            if (r_o > r_q && c_o > c_q) up_right = (r_o - r_q - 1 < up_right) ? r_o - r_q - 1 : up_right;
            else if (r_o > r_q && c_o < c_q) up_left = (r_o - r_q - 1 < up_left) ? r_o - r_q - 1 : up_left;
            else if (r_o < r_q && c_o > c_q) down_right = (r_q - r_o - 1 < down_right) ? r_q - r_o - 1 : down_right;
            else if (r_o < r_q && c_o < c_q) down_left = (r_q - r_o - 1 < down_left) ? r_q - r_o - 1 : down_left;
        }
    }

    return up + down + left + right + up_left + up_right + down_left + down_right;
}
