int* stones(int n, int a, int b, int* result_count) {
    int size = n;
    int* results = malloc(size * sizeof(int));
    int index = 0;

    if (a > b) {
        int temp = a;
        a = b;
        b = temp;
    }

    for (int i = 0; i < n; i++) {
        int value = i * b + (n - 1 - i) * a;
        results[index++] = value;
    }

    *result_count = index;
    return results;
}
